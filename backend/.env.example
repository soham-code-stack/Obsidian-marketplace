# ---------------------------------------------------
# Server
# ---------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) — set to your Vercel URL in production
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------
# MongoDB Atlas
# Create a free cluster at https://cloud.mongodb.com
# Replace <username>, <password>, <cluster-url>, <dbname>
# ---------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# ---------------------------------------------------
# JWT Auth
# Generate strong random secrets, e.g.: openssl rand -base64 64
# ---------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------------------------------------------------
# Meilisearch
# Local: run via docker (see README) -> http://localhost:7700
# Hosted: use your Meilisearch Cloud URL + API key
# ---------------------------------------------------
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=replace_with_your_meilisearch_master_key

# ---------------------------------------------------
# Stripe (TEST MODE ONLY — keys starting with sk_test_ / pk_test_)
# Get these from https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
